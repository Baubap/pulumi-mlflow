#!/usr/bin/env bash
# Auto-regenerate the committed schema.json and the SDKs whenever provider source
# changes, so they never drift from the Go code. Staged automatically.
#
# Committed SDKs use a fixed 0.0.0 placeholder version — the real version is
# injected from the git tag at release time (see release.yml / provider-version-action),
# so this keeps the committed tree deterministic (no per-commit version churn).
#
# Enable with: make install-hooks   (sets core.hooksPath to .githooks)
set -euo pipefail

# Only run when schema-affecting provider Go source is staged (skip tests/docs/CI).
changed="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^provider/.*\.go$' | grep -vE '_test\.go$' || true)"
if [ -z "$changed" ]; then
  exit 0
fi

echo "pre-commit: provider Go source changed → regenerating schema + SDKs…"

# Make Go / pulumi / pulumictl / yarn discoverable in a hook's minimal env.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
if command -v npm >/dev/null 2>&1; then export PATH="$PATH:$(npm root -g)/../bin"; fi

VER="0.0.0"
BIN="bin/pulumi-resource-mlflow"

# Force a fresh provider build (the `provider` make target has no source prereqs).
go build -o "$BIN" -ldflags "-X github.com/Baubap/pulumi-mlflow/provider/version.Version=${VER}" ./provider/cmd/pulumi-resource-mlflow

# Schema (version stripped) + SDKs at the fixed placeholder version.
pulumi package get-schema "$BIN" | jq 'del(.version)' > provider/cmd/pulumi-resource-mlflow/schema.json
make generate_nodejs generate_python generate_go PROVIDER_VERSION="${VER}" >/dev/null

git add provider/cmd/pulumi-resource-mlflow/schema.json sdk/
echo "pre-commit: schema.json + SDKs regenerated and staged."
